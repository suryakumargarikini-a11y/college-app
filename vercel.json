{
  "name": "sitam-erp-admin",
  "version": 2,
  "buildCommand": "cd admin-portal && npm install && npm run build",
  "outputDirectory": "admin-portal/dist",
  "installCommand": "npm install --prefix admin-portal",
  "rewrites": [
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}