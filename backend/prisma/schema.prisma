generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id                         String              @id @default(uuid())
  userId                     String              @unique
  password                   String
  name                       String
  roll                       String
  roll_number                String?             @default("")
  program                    String
  branch                     String
  semester                   String
  section                    String?             @default("A")
  year                       String
  gender                     String
  dob                        String
  email                      String
  phone                      String
  fatherName                 String
  motherName                 String
  fatherMobile               String
  hostel                     String
  roomNo                     String
  cgpa                       String
  percentage                 String
  address                    String
  admissionNo                String?             @default("")
  joiningDate                String?             @default("")
  caste                      String?             @default("")
  nationality                String?             @default("")
  religion                   String?             @default("")
  sscMarks                   String?             @default("")
  interMarks                 String?             @default("")
  scholarship                String?             @default("")
  seatType                   String?             @default("")
  entranceType               String?             @default("")
  entranceRank               String?             @default("")
  aadhar                     String?             @default("")
  photoUrl                   String?             @default("")
  guardianName               String?             @default("")
  guardianPhone              String?             @default("")
  guardianAddress            String?             @default("")
  lastSync                   DateTime?
  isSyncing                  Boolean             @default(false)
  bloodGroup                 String?             @default("")
  emergencyContact           String?             @default("")
  apaarId                    String?             @default("")
  motherMobile               String?             @default("")
  annualIncome               String?             @default("")
  fatherEmail                String?             @default("")
  motherEmail                String?             @default("")
  fatherOccupation           String?             @default("")
  motherOccupation           String?             @default("")
  correspondenceAddress      String?             @default("")
  lastStudied                String?             @default("")
  sgpa                       String?             @default("")
  academicYear               String?             @default("")
  academicHistory            Json?
  targetedAdminNotifications AdminNotification[] @relation("AdminNotificationTargetStudent")
  assignments                Assignment[]
  attendance                 AttendanceRecord[]
  auditLogs                  AuditLog[]
  exitPasses                 ExitPass[]
  fcmTokens                  FcmToken[]
  fees                       Fee[]
  feeReminderLogs            FeeReminderLog[]
  helpTickets                HelpTicket[]
  libraryAudiences           LibraryAudience[]
  libraryDownloads           LibraryDownload[]
  libraryViews               LibraryView[]
  lmsSubmissions             LmsSubmission[]
  lostFoundClaims            LostFoundClaim[]
  marks                      MarkRecord[]
  notifications              Notification[]
  notificationEvents         NotificationEvent[]
  notificationReads          NotificationRead[]
  savedPlacements            SavedPlacement[]
  surveyResponses            SurveyResponse[]
  syncHistory                SyncHistory[]
  timetable                  TimetableSlot[]

  @@index([email])
  @@index([roll])
  @@index([branch])
  @@index([year])
}

model Subject {
  id             String             @id @default(uuid())
  code           String             @unique
  name           String
  credits        String
  semester       String
  branch         String?            @default("")
  attendance     AttendanceRecord[]
  lmsAssignments LmsAssignment[]
  marks          MarkRecord[]
  studyMaterials StudyMaterial[]
  syllabus       SyllabusUnit[]
  timetable      TimetableSlot[]
}

model MarkRecord {
  id        String  @id @default(uuid())
  studentId String
  subjectId String
  grade     String
  credits   String
  type      String
  marks     Int     @default(0)
  maxMarks  Int     @default(100)
  status    String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([subjectId])
  @@index([studentId, subjectId])
}

model AttendanceRecord {
  id         String  @id @default(uuid())
  studentId  String
  subjectId  String
  held       Int
  attended   Int
  percentage Float
  status     String
  date       String? @default("")
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject    Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([subjectId])
  @@index([studentId, subjectId])
}

model Fee {
  id              String           @id @default(uuid())
  studentId       String
  semester        String
  feeType         String
  amount          Float
  paidAmount      Float
  dueAmount       Float
  dueDate         String
  paymentStatus   String
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeReminderLogs FeeReminderLog[]

  @@index([studentId])
  @@index([studentId, semester])
  @@index([paymentStatus])
  @@index([dueDate])
}

model TimetableSlot {
  id          String  @id @default(uuid())
  studentId   String
  subjectId   String
  day         String
  period      String
  room        String
  section     String
  facultyName String
  time        String
  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject     Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([subjectId])
  @@index([studentId, day])
}

model SyllabusUnit {
  id         String  @id @default(uuid())
  subjectId  String
  unitNumber Int
  title      String
  content    String
  completed  Boolean @default(false)
  subject    Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId])
}

model Assignment {
  id        String  @id @default(uuid())
  studentId String
  title     String
  subject   String
  status    String
  date      String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model Notification {
  id         String   @id @default(uuid())
  studentId  String
  title      String
  message    String
  type       String   @default("general")
  category   String   @default("info")
  metadata   String?
  changeHash String?
  isRead     Boolean  @default(false)
  date       String
  createdAt  DateTime @default(now())
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([studentId, isRead])
  @@index([studentId, type])
  @@index([studentId, createdAt])
  @@index([changeHash])
}

model NotificationEvent {
  id         String   @id @default(uuid())
  studentId  String
  eventType  String
  changeHash String   @unique
  oldValue   String?
  newValue   String?
  metadata   String?
  notified   Boolean  @default(false)
  createdAt  DateTime @default(now())
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([studentId, eventType])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  studentId String?
  adminId   String?
  action    String
  details   String
  severity  String   @default("INFO")
  timestamp DateTime @default(now())
  admin     Admin?   @relation(fields: [adminId], references: [id])
  student   Student? @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([adminId])
  @@index([timestamp])
  @@index([severity])
}

model Session {
  id          String   @id @default(uuid())
  token       String   @unique
  userId      String
  password    String   @default("")
  cookies     String   @default("")
  scrapedData String   @default("{}")
  lastUsed    DateTime @default(now())
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model FcmToken {
  id         String   @id @default(uuid())
  studentId  String
  token      String   @unique
  deviceType String?  @default("android")
  createdAt  DateTime @default(now())
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model SreAuditChain {
  id            String   @id @default(uuid())
  index         Int      @unique
  timestamp     DateTime @default(now())
  actionType    String
  payload       String
  prevBlockHash String
  blockHash     String
}

model SreQuorumVote {
  id           String   @id @default(uuid())
  proposalId   String   @unique
  timestamp    DateTime @default(now())
  actionType   String
  payload      String
  status       String
  voters       String
  votesFor     Int      @default(0)
  votesAgainst Int      @default(0)
}

model SreTenantQuota {
  id           String   @id @default(uuid())
  userId       String   @unique
  riskScore    Float    @default(0.0)
  activeQuotas Int      @default(0)
  maxConcur    Int      @default(1)
  isThrottled  Boolean  @default(false)
  updatedAt    DateTime @updatedAt
}

model SreIncident {
  id          String   @id @default(uuid())
  level       String
  category    String
  status      String
  description String
  rootCause   String?  @default("")
  durationMs  Int      @default(0)
  traceRef    String?  @default("")
  timestamp   DateTime @default(now())
}

model Admin {
  id                     String            @id @default(uuid())
  email                  String            @unique
  passwordHash           String
  name                   String
  role                   String            @default("SUPER_ADMIN")
  isActive               Boolean           @default(true)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  createdAchievements    Achievement[]
  auditLogs              AuditLog[]
  uploadedMaterials      LibraryMaterial[]
  createdLmsAssignments  LmsAssignment[]
  gradedLmsSubmissions   LmsSubmission[]
  staffScopes            StaffScope[]
  uploadedStudyMaterials StudyMaterial[]

  @@index([role])
}

model Announcement {
  id          String   @id @default(uuid())
  title       String
  description String
  priority    String   @default("NORMAL")
  category    String   @default("GENERAL")
  link        String?
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Placement {
  id                  String           @id @default(uuid())
  companyName         String
  companyLogoUrl      String?
  jobRole             String
  packageLpa          String
  eligibility         String
  description         String
  registrationLink    String
  driveDate           String
  type                String           @default("PLACEMENT")
  location            String?          @default("")
  lastDate            String?          @default("")
  status              String           @default("DRAFT")
  notificationSent    Boolean          @default(false)
  companyArrivedToday Boolean          @default(false)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  savedPlacements     SavedPlacement[]

  @@index([status])
  @@index([driveDate])
  @@index([companyArrivedToday])
  @@index([createdAt])
}

model CompanyVisit {
  id             String   @id @default(uuid())
  companyName    String
  companyLogoUrl String?
  visitDate      String
  packageLpa     String
  eligibility    String
  jobRoles       String
  driveRounds    String?
  venue          String
  status         String   @default("UPCOMING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([visitDate])
}

model FeeNotice {
  id                     String   @id @default(uuid())
  title                  String
  description            String
  dueDate                String
  targetBatch            String   @default("ALL")
  priority               String   @default("NORMAL")
  popupEnabled           Boolean  @default(true)
  notificationEnabled    Boolean  @default(true)
  hallTicketBlockWarning Boolean  @default(false)
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([isActive])
  @@index([dueDate])
}

model ExitPass {
  id                     String                @id @default(uuid())
  studentId              String
  reason                 String
  destination            String
  requestedDate          String
  status                 String                @default("PENDING")
  otpHash                String?
  otpExpiry              DateTime?
  qrCode                 String?
  rejectionNote          String?
  approvedAt             DateTime?
  approvedBy             String?
  verifiedAt             DateTime?
  verifiedBy             String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  exitTime               DateTime?
  returnTime             DateTime?
  emergencyContact       String?
  remarks                String?
  adminRemark            String?
  groupRequestId         String?
  academicYear           String?
  semester               String?
  qrTokenHash            String?
  exitConfirmedAt        DateTime?
  exitConfirmedBy        String?
  verificationMethod     String?
  parentSmsStatus        String?
  parentSmsId            String?
  exitGate               String?
  identityMismatchReason String?
  otpAttempts            Int                   @default(0)
  returnedAt             DateTime?
  returnedBy             String?
  returnGate             String?
  groupRequest           GroupExitPassRequest? @relation(fields: [groupRequestId], references: [id])
  student                Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
  @@index([createdAt])
  @@index([otpHash])
  @@index([approvedAt])
  @@index([qrTokenHash])
  @@index([groupRequestId])
  @@index([exitConfirmedAt])
}

model GroupExitPassRequest {
  id            String     @id @default(uuid())
  groupName     String
  reason        String
  destination   String
  exitTime      DateTime
  returnTime    DateTime
  status        String     @default("PENDING")
  leaderId      String
  rejectionNote String?
  approvedAt    DateTime?
  approvedBy    String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  passes        ExitPass[]

  @@index([status])
  @@index([createdAt])
}

model SmsLog {
  id        String   @id @default(uuid())
  studentId String
  passId    String?
  type      String
  recipient String
  status    String
  error     String?
  sentAt    DateTime @default(now())
}

model AdminNotification {
  id              String             @id @default(uuid())
  title           String
  message         String
  targetAudience  String             @default("ALL")
  targetBranches  String?
  targetYears     String?
  targetSections  String?
  priority        String             @default("NORMAL")
  sentAt          DateTime           @default(now())
  sentBy          String
  expiresAt       DateTime?
  status          String             @default("PUBLISHED")
  targetStudentId String?
  createdAt       DateTime           @default(now())
  publishedAt     DateTime?
  updatedAt       DateTime           @updatedAt
  targetStudent   Student?           @relation("AdminNotificationTargetStudent", fields: [targetStudentId], references: [id])
  reads           NotificationRead[]

  @@index([sentAt])
  @@index([status])
  @@index([targetStudentId])
}

model LibraryMaterial {
  id                String            @id @default(uuid())
  title             String
  description       String?
  fileName          String            @unique
  originalFileName  String
  fileUrl           String
  fileType          String
  mimeType          String
  fileSize          Int
  category          String            @default("GENERAL")
  subject           String?
  branch            String?
  semester          String?
  section           String?
  academicYear      String?
  uploadedBy        String
  uploadedByRole    String
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  expiresAt         DateTime?
  uploadedByAdminId String?
  audiences         LibraryAudience[]
  downloads         LibraryDownload[]
  uploadedAdmin     Admin?            @relation(fields: [uploadedByAdminId], references: [id])
  views             LibraryView[]

  @@index([isActive, createdAt])
  @@index([branch, semester, section, academicYear])
  @@index([subject])
  @@index([uploadedByAdminId])
  @@index([expiresAt])
}

model LibraryView {
  id         String          @id @default(uuid())
  studentId  String
  materialId String
  viewedAt   DateTime        @default(now())
  material   LibraryMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  student    Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, materialId])
  @@index([materialId])
}

model LibraryDownload {
  id           String          @id @default(uuid())
  studentId    String
  materialId   String
  downloadedAt DateTime        @default(now())
  material     LibraryMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  student      Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, materialId])
  @@index([materialId])
}

model NotificationRead {
  id             String            @id @default(uuid())
  studentId      String
  notificationId String
  readAt         DateTime          @default(now())
  notification   AdminNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  student        Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, notificationId])
  @@index([studentId])
  @@index([notificationId])
}

model SystemSetting {
  id                 String   @id @default("system")
  maintenanceMode    Boolean  @default(false)
  maintenanceMessage String   @default("SITAM Smart ERP is currently undergoing scheduled maintenance. Please try again later.")
  updatedAt          DateTime @updatedAt
}

model FeeReminderLog {
  id            String   @id @default(uuid())
  studentId     String
  feeId         String
  reminderStage String
  sentAt        DateTime @default(now())
  fee           Fee      @relation(fields: [feeId], references: [id], onDelete: Cascade)
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, feeId, reminderStage])
  @@index([studentId])
  @@index([feeId])
}

model SavedPlacement {
  id          String    @id @default(uuid())
  studentId   String
  placementId String
  savedAt     DateTime  @default(now())
  placement   Placement @relation(fields: [placementId], references: [id], onDelete: Cascade)
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, placementId])
  @@index([studentId])
}

model Survey {
  id          String           @id @default(uuid())
  title       String
  description String
  status      String           @default("ACTIVE")
  isAnonymous Boolean          @default(false)
  expiresAt   DateTime?
  createdBy   String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  questions   SurveyQuestion[]
  responses   SurveyResponse[]

  @@index([status])
  @@index([expiresAt])
}

model SurveyQuestion {
  id       String         @id @default(uuid())
  surveyId String
  text     String
  type     String
  options  String?
  order    Int
  answers  SurveyAnswer[]
  survey   Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId])
}

model SurveyResponse {
  id          String         @id @default(uuid())
  surveyId    String
  studentId   String
  submittedAt DateTime       @default(now())
  answers     SurveyAnswer[]
  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  survey      Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@unique([surveyId, studentId])
  @@index([surveyId])
  @@index([studentId])
}

model SurveyAnswer {
  id         String         @id @default(uuid())
  responseId String
  questionId String
  answer     String
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  response   SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([responseId])
}

model HelpTicket {
  id                    String        @id @default(uuid())
  studentId             String
  ticketNumber          String        @unique
  subject               String
  description           String
  category              String
  priority              String        @default("NORMAL")
  status                String        @default("OPEN")
  estimatedResponseTime String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  student               Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  replies               TicketReply[]

  @@index([studentId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model TicketReply {
  id         String     @id @default(uuid())
  ticketId   String
  message    String
  senderType String
  senderId   String
  senderName String
  createdAt  DateTime   @default(now())
  ticket     HelpTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model LostFoundItem {
  id          String           @id @default(uuid())
  title       String
  description String
  location    String
  type        String
  imageUrls   String?          @default("")
  status      String           @default("ACTIVE")
  ownerName   String
  studentId   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  claims      LostFoundClaim[]

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model LostFoundClaim {
  id        String        @id @default(uuid())
  itemId    String
  studentId String
  message   String?
  status    String        @default("PENDING")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  item      LostFoundItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  student   Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([itemId, studentId])
  @@index([itemId])
  @@index([studentId])
}

model SyncHistory {
  id           String    @id @default(uuid())
  requestId    String    @unique
  studentId    String
  provider     String
  browserId    String?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  status       String    @default("RUNNING")
  durationMs   Int?
  pagesScraped String?   @default("{}")
  error        String?
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([startedAt])
  @@index([status])
}

/// Maps a staff Admin to one or more canonical academic department scopes.
/// HOD rows: 1 row per dept (e.g. scopeValue = "AIML").
/// Dean rows: 9 rows (one per canonical dept).
/// CI row:    1 row with scopeType = "INSTITUTION_WIDE", scopeValue = "ALL".
/// Faculty:   1+ rows depending on department assignment.
/// HOSTEL_WARDEN / SECURITY_GUARD / ACCOUNTS_ADMIN: no rows (different access model).
model StaffScope {
  id         String   @id @default(uuid())
  adminId    String
  scopeType  String   @default("DEPARTMENT")
  scopeValue String
  createdAt  DateTime @default(now())
  admin      Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, scopeType, scopeValue])
  @@index([adminId])
  @@index([scopeValue])
}

/// Maps raw ERP Student.branch strings to canonical department keys.
model DepartmentAlias {
  id        String   @id @default(uuid())
  rawValue  String   @unique
  canonical String
  createdAt DateTime @default(now())

  @@index([canonical])
}

/// Audience targeting rows for E-Library materials.
model LibraryAudience {
  id         String          @id @default(uuid())
  materialId String
  targetType String
  canonical  String?
  year       String?
  semester   String?
  section    String?
  studentId  String?
  createdAt  DateTime        @default(now())
  material   LibraryMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  student    Student?        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@index([canonical])
  @@index([studentId])
  @@index([targetType])
}

model StudyMaterial {
  id                String   @id @default(uuid())
  subjectId         String?
  title             String
  description       String?
  category          String   @default("LECTURE_NOTE")
  fileUrl           String?
  fileName          String?
  uploadedByAdminId String?
  uploadedByName    String?
  uploadedByRole    String?
  branch            String?  @default("")
  year              String?  @default("")
  semester          String?  @default("")
  section           String?  @default("ALL")
  publishedAt       DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  subject           Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  uploadedByAdmin   Admin?   @relation(fields: [uploadedByAdminId], references: [id])

  @@index([branch, semester, section])
  @@index([subjectId])
  @@index([uploadedByAdminId])
  @@index([createdAt])
}

model LmsAssignment {
  id               String          @id @default(uuid())
  subjectId        String?
  subjectCode      String?
  subjectName      String?
  title            String
  description      String?
  instructions     String?
  dueDate          DateTime
  maxMarks         Int             @default(100)
  attachmentUrl    String?
  attachmentName   String?
  createdByAdminId String?
  createdByName    String?
  createdByRole    String?
  branch           String?         @default("")
  year             String?         @default("")
  semester         String?         @default("")
  section          String?         @default("ALL")
  status           String          @default("PUBLISHED")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  createdByAdmin   Admin?          @relation(fields: [createdByAdminId], references: [id])
  subject          Subject?        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  submissions      LmsSubmission[]

  @@index([branch, semester, section])
  @@index([subjectId])
  @@index([dueDate])
  @@index([status])
  @@index([createdByAdminId])
}

model LmsSubmission {
  id              String        @id @default(uuid())
  assignmentId    String
  studentId       String
  submissionText  String?
  fileUrl         String?
  fileName        String?
  submittedAt     DateTime      @default(now())
  status          String        @default("SUBMITTED")
  marks           Float?
  grade           String?
  feedback        String?
  gradedAt        DateTime?
  gradedByAdminId String?
  gradedByName    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  assignment      LmsAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  gradedByAdmin   Admin?        @relation(fields: [gradedByAdminId], references: [id])
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@index([status])
  @@index([gradedByAdminId])
}

model Achievement {
  id               String   @id @default(uuid())
  title            String
  description      String
  imageUrl         String?
  achievementDate  DateTime @default(now())
  category         String   @default("OTHER")
  branch           String
  participantName  String?
  createdByAdminId String?
  createdByName    String?
  createdByRole    String?
  isPublished      Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdByAdmin   Admin?   @relation(fields: [createdByAdminId], references: [id])

  @@index([branch])
  @@index([isPublished])
  @@index([category])
  @@index([createdAt])
}
