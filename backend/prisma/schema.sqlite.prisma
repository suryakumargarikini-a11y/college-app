datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model Student {
  id                 String              @id @default(uuid())
  userId             String              @unique // Roll No / Username (E.g. 25B61A0596)
  password           String
  name               String
  roll               String
  roll_number        String?             @default("") // Campus schema alignment
  program            String
  branch             String
  semester           String
  section            String?             @default("A") // Section assignment
  year               String
  gender             String
  dob                String
  email              String
  phone              String
  fatherName         String
  motherName         String
  fatherMobile       String
  hostel             String
  roomNo             String
  cgpa               String
  percentage         String
  address            String
  admissionNo        String?             @default("")
  joiningDate        String?             @default("")
  caste              String?             @default("")
  nationality        String?             @default("")
  religion           String?             @default("")
  sscMarks           String?             @default("")
  interMarks         String?             @default("")
  scholarship        String?             @default("")
  seatType           String?             @default("")
  entranceType       String?             @default("")
  entranceRank       String?             @default("")
  aadhar             String?             @default("")
  photoUrl           String?             @default("")
  guardianName       String?             @default("")
  guardianPhone      String?             @default("")
  guardianAddress    String?             @default("")
  apaarId            String?             @default("") // Government APAAR/ABC ID — sensitive, owner-only
  motherMobile       String?             @default("")
  annualIncome       String?             @default("")
  fatherEmail        String?             @default("")
  motherEmail        String?             @default("")
  fatherOccupation   String?             @default("")
  motherOccupation   String?             @default("")
  correspondenceAddress String?          @default("")
  lastStudied        String?             @default("") // Previous institution name
  sgpa               String?             @default("") // Latest semester GPA
  academicYear       String?             @default("") // E.g. 2025-26
  academicHistory    String?             @default("") // JSON text of complete semester history and overall results
  lastSync           DateTime? // Track when this student was last sync-scraped
  isSyncing          Boolean             @default(false)
  marks              MarkRecord[]
  attendance         AttendanceRecord[]
  timetable          TimetableSlot[]
  assignments        Assignment[]
  notifications      Notification[]
  notificationEvents NotificationEvent[]
  auditLogs          AuditLog[]
  fees               Fee[]
  fcmTokens          FcmToken[]
  exitPasses         ExitPass[]
  feeReminderLogs    FeeReminderLog[]
  bloodGroup         String?             @default("")
  emergencyContact   String?             @default("")
  surveyResponses    SurveyResponse[]
  helpTickets        HelpTicket[]
  savedPlacements    SavedPlacement[]
  lostFoundClaims    LostFoundClaim[]
  notificationReads  NotificationRead[]
  targetedAdminNotifications AdminNotification[] @relation("AdminNotificationTargetStudent")
  syncHistory        SyncHistory[]
  libraryViews       LibraryView[]
  libraryDownloads   LibraryDownload[]
  libraryAudiences   LibraryAudience[]
  lmsSubmissions     LmsSubmission[]

  @@index([email])
  @@index([roll])
  @@index([branch])
  @@index([year])
}

model Subject {
  id         String             @id @default(uuid())
  code       String             @unique // E.g., CS-402, CS-402-LAB
  name       String
  credits    String
  semester   String
  branch     String?            @default("") // Course mapping alignment
  marks      MarkRecord[]
  attendance AttendanceRecord[]
  timetable  TimetableSlot[]
  syllabus   SyllabusUnit[]
  studyMaterials StudyMaterial[]
  lmsAssignments LmsAssignment[]
}

model MarkRecord {
  id        String  @id @default(uuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  grade     String // A+, B, Absent, Backlog
  credits   String
  type      String // Core / Lab
  marks     Int     @default(0)
  maxMarks  Int     @default(100)
  status    String // Pass, Fail, Absent, Backlog

  @@index([studentId])
  @@index([subjectId])
  @@index([studentId, subjectId])
}

model AttendanceRecord {
  id         String  @id @default(uuid())
  studentId  String
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId  String
  subject    Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  held       Int
  attended   Int
  percentage Float // (attended / held) * 100
  status     String // Excellent, Good, Acceptable, Warning (Defaulter < 75%)
  date       String? @default("") // Date of mapped record

  @@index([studentId])
  @@index([subjectId])
  @@index([studentId, subjectId])
}

model Fee {
  id              String           @id @default(uuid())
  studentId       String
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  semester        String
  feeType         String // e.g. Tuition Fee, Hostel Fee
  amount          Float
  paidAmount      Float
  dueAmount       Float
  dueDate         String // due date string
  paymentStatus   String // Paid, Unpaid, Partial, Completed, Due
  feeReminderLogs FeeReminderLog[]

  @@index([studentId])
  @@index([studentId, semester])
  @@index([paymentStatus])
  @@index([dueDate])
}

model TimetableSlot {
  id          String  @id @default(uuid())
  studentId   String
  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  day         String // Monday, Tuesday, etc.
  period      String // 1, 2, 3, etc.
  room        String
  section     String
  facultyName String
  time        String // E.g., 09:00 AM

  @@index([studentId])
  @@index([subjectId])
  @@index([studentId, day])
}

model SyllabusUnit {
  id         String  @id @default(uuid())
  subjectId  String
  subject    Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  unitNumber Int
  title      String
  content    String // Unit syllabus text
  completed  Boolean @default(false)

  @@index([subjectId])
}

model Assignment {
  id        String  @id @default(uuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title     String
  subject   String
  status    String // Pending, Submitted
  date      String // Due date text

  @@index([studentId])
}

model Notification {
  id         String   @id @default(uuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title      String
  message    String
  type       String   @default("general")
  category   String   @default("info")
  metadata   String?
  changeHash String?
  isRead     Boolean  @default(false)
  date       String
  createdAt  DateTime @default(now())

  @@index([studentId])
  @@index([studentId, isRead])
  @@index([studentId, type])
  @@index([studentId, createdAt])
  @@index([changeHash])
}

model NotificationEvent {
  id         String   @id @default(uuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  eventType  String
  changeHash String
  oldValue   String?
  newValue   String?
  metadata   String?
  notified   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([changeHash])
  @@index([studentId])
  @@index([studentId, eventType])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  adminId   String?
  admin     Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action    String
  details   String
  severity  String   @default("INFO")
  timestamp DateTime @default(now())

  @@index([studentId])
  @@index([adminId])
  @@index([timestamp])
  @@index([severity])
}

model Session {
  id          String   @id @default(uuid())
  token       String   @unique
  userId      String
  password    String   @default("")
  cookies     String   @default("")
  scrapedData String   @default("{}")
  lastUsed    DateTime @default(now())
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model FcmToken {
  id         String   @id @default(uuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  token      String   @unique
  deviceType String?  @default("android")
  createdAt  DateTime @default(now())

  @@index([studentId])
}

model SreAuditChain {
  id            String   @id @default(uuid())
  index         Int      @unique
  timestamp     DateTime @default(now())
  actionType    String
  payload       String
  prevBlockHash String
  blockHash     String
}

model SreQuorumVote {
  id           String   @id @default(uuid())
  proposalId   String   @unique
  timestamp    DateTime @default(now())
  actionType   String
  payload      String
  status       String
  voters       String
  votesFor     Int      @default(0)
  votesAgainst Int      @default(0)
}

model SreTenantQuota {
  id           String   @id @default(uuid())
  userId       String   @unique
  riskScore    Float    @default(0.0)
  activeQuotas Int      @default(0)
  maxConcur    Int      @default(1)
  isThrottled  Boolean  @default(false)
  updatedAt    DateTime @updatedAt
}

model SreIncident {
  id          String   @id @default(uuid())
  level       String
  category    String
  status      String
  description String
  rootCause   String?  @default("")
  durationMs  Int      @default(0)
  traceRef    String?  @default("")
  timestamp   DateTime @default(now())
}

model Admin {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String
  role         String     @default("SUPER_ADMIN")
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs         AuditLog[]
  staffScopes       StaffScope[]
  uploadedMaterials LibraryMaterial[]
  uploadedStudyMaterials StudyMaterial[]
  createdLmsAssignments  LmsAssignment[]
  gradedLmsSubmissions   LmsSubmission[]
  createdAchievements    Achievement[]

  @@index([role])
}

model Announcement {
  id          String   @id @default(uuid())
  title       String
  description String
  priority    String   @default("NORMAL")
  category    String   @default("GENERAL")
  link        String?
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Placement {
  id                  String   @id @default(uuid())
  companyName         String
  companyLogoUrl      String?
  jobRole             String
  packageLpa          String
  eligibility         String
  description         String
  registrationLink    String
  driveDate           String
  type                String   @default("PLACEMENT")
  location            String?  @default("")
  lastDate            String?  @default("")
  status              String   @default("DRAFT")
  notificationSent    Boolean  @default(false)
  companyArrivedToday Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  savedPlacements     SavedPlacement[]

  @@index([status])
  @@index([driveDate])
  @@index([companyArrivedToday])
  @@index([createdAt])
}

model CompanyVisit {
  id             String   @id @default(uuid())
  companyName    String
  companyLogoUrl String?
  visitDate      String
  packageLpa     String
  eligibility    String
  jobRoles       String
  driveRounds    String?
  venue          String
  status         String   @default("UPCOMING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([visitDate])
}

model FeeNotice {
  id                     String   @id @default(uuid())
  title                  String
  description            String
  dueDate                String
  targetBatch            String   @default("ALL")
  priority               String   @default("NORMAL")
  popupEnabled           Boolean  @default(true)
  notificationEnabled    Boolean  @default(true)
  hallTicketBlockWarning Boolean  @default(false)
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([isActive])
  @@index([dueDate])
}

model ExitPass {
  id                     String                @id @default(uuid())
  studentId              String
  student                Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reason                 String
  destination            String
  requestedDate          String
  status                 String                @default("PENDING")
  otpHash                String?
  otpExpiry              DateTime?
  qrCode                 String?
  rejectionNote          String?
  approvedAt             DateTime?
  approvedBy             String?
  verifiedAt             DateTime?
  verifiedBy             String?
  exitTime               DateTime?
  returnTime             DateTime?
  emergencyContact       String?
  remarks                String?
  adminRemark            String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  groupRequestId         String?
  groupRequest           GroupExitPassRequest? @relation(fields: [groupRequestId], references: [id], onDelete: SetNull)
  academicYear           String?
  semester               String?
  qrTokenHash            String?
  exitConfirmedAt        DateTime?
  exitConfirmedBy        String?
  verificationMethod     String?
  parentSmsStatus        String?
  parentSmsId            String?
  exitGate               String?
  returnedAt             DateTime?
  returnedBy             String?
  returnGate             String?
  identityMismatchReason String?
  otpAttempts            Int                   @default(0)

  @@index([studentId])
  @@index([status])
  @@index([createdAt])
  @@index([otpHash])
  @@index([approvedAt])
  @@index([qrTokenHash])
  @@index([groupRequestId])
  @@index([exitConfirmedAt])
}

model GroupExitPassRequest {
  id            String     @id @default(uuid())
  groupName     String
  reason        String
  destination   String
  exitTime      DateTime
  returnTime    DateTime
  status        String     @default("PENDING")
  leaderId      String
  rejectionNote String?
  approvedAt    DateTime?
  approvedBy    String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  passes        ExitPass[]

  @@index([status])
  @@index([createdAt])
}

model SmsLog {
  id         String   @id @default(uuid())
  studentId  String
  passId     String?
  type       String
  recipient  String
  status     String
  error      String?
  sentAt     DateTime @default(now())
}

model AdminNotification {
  id              String   @id @default(uuid())
  title           String
  message         String
  targetAudience  String   @default("ALL")
  targetBranches  String?
  targetYears     String?
  targetSections  String?
  priority        String   @default("NORMAL")
  sentAt          DateTime @default(now())
  sentBy          String
  expiresAt       DateTime?
  status          String   @default("PUBLISHED")
  targetStudentId String?
  targetStudent   Student? @relation("AdminNotificationTargetStudent", fields: [targetStudentId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  publishedAt     DateTime?
  updatedAt       DateTime @updatedAt
  reads           NotificationRead[]

  @@index([sentAt])
  @@index([status])
  @@index([targetStudentId])
}

model LibraryMaterial {
  id String @id @default(uuid())
  title String
  description String?
  fileName String @unique
  originalFileName String
  fileUrl String
  fileType String
  mimeType String
  fileSize Int
  category String @default("GENERAL")
  subject String?
  branch String?
  semester String?
  section String?
  academicYear String?
  uploadedBy String
  uploadedByRole String
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  views             LibraryView[]
  downloads         LibraryDownload[]
  expiresAt         DateTime?
  uploadedByAdminId String?
  uploadedAdmin     Admin?            @relation(fields: [uploadedByAdminId], references: [id], onDelete: SetNull)
  audiences         LibraryAudience[]
  @@index([isActive, createdAt])
  @@index([branch, semester, section, academicYear])
  @@index([subject])
  @@index([uploadedByAdminId])
  @@index([expiresAt])
}
model LibraryView {
  id String @id @default(uuid())
  studentId String
  materialId String
  viewedAt DateTime @default(now())
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  material LibraryMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  @@unique([studentId, materialId])
  @@index([materialId])
}
model LibraryDownload {
  id String @id @default(uuid())
  studentId String
  materialId String
  downloadedAt DateTime @default(now())
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  material LibraryMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  @@unique([studentId, materialId])
  @@index([materialId])
}

model NotificationRead {
  id             String            @id @default(uuid())
  studentId      String
  student        Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  notificationId String
  notification   AdminNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  readAt         DateTime          @default(now())

  @@unique([studentId, notificationId])
  @@index([studentId])
  @@index([notificationId])
}

model SystemSetting {
  id                 String   @id @default("system")
  maintenanceMode    Boolean  @default(false)
  maintenanceMessage String   @default("SITAM Smart ERP is currently undergoing scheduled maintenance. Please try again later.")
  updatedAt          DateTime @updatedAt
}

model FeeReminderLog {
  id            String   @id @default(uuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeId         String
  fee           Fee      @relation(fields: [feeId], references: [id], onDelete: Cascade)
  reminderStage String
  sentAt        DateTime @default(now())

  @@unique([studentId, feeId, reminderStage])
  @@index([studentId])
  @@index([feeId])
}

model SavedPlacement {
  id          String    @id @default(uuid())
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  placementId String
  placement   Placement @relation(fields: [placementId], references: [id], onDelete: Cascade)
  savedAt     DateTime  @default(now())

  @@unique([studentId, placementId])
  @@index([studentId])
}

model Survey {
  id          String           @id @default(uuid())
  title       String
  description String
  status      String           @default("ACTIVE")
  isAnonymous Boolean          @default(false)
  expiresAt   DateTime?
  createdBy   String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  questions   SurveyQuestion[]
  responses   SurveyResponse[]

  @@index([status])
  @@index([expiresAt])
}

model SurveyQuestion {
  id       String         @id @default(uuid())
  surveyId String
  survey   Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  text     String
  type     String
  options  String?
  order    Int
  answers  SurveyAnswer[]

  @@index([surveyId])
}

model SurveyResponse {
  id          String         @id @default(uuid())
  surveyId    String
  survey      Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submittedAt DateTime       @default(now())
  answers     SurveyAnswer[]

  @@unique([surveyId, studentId])
  @@index([surveyId])
  @@index([studentId])
}

model SurveyAnswer {
  id         String         @id @default(uuid())
  responseId String
  response   SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId String
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer     String

  @@index([responseId])
}

model HelpTicket {
  id                   String        @id @default(uuid())
  studentId            String
  student              Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  ticketNumber         String        @unique
  subject              String
  description          String
  category             String
  priority             String        @default("NORMAL")
  status               String        @default("OPEN")
  estimatedResponseTime String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  replies              TicketReply[]

  @@index([studentId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model TicketReply {
  id         String     @id @default(uuid())
  ticketId   String
  ticket     HelpTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message    String
  senderType String
  senderId   String
  senderName String
  createdAt  DateTime   @default(now())

  @@index([ticketId])
}

model LostFoundItem {
  id          String           @id @default(uuid())
  title       String
  description String
  location    String
  type        String
  imageUrls   String?          @default("")
  status      String           @default("ACTIVE")
  ownerName   String
  studentId   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  claims      LostFoundClaim[]

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model LostFoundClaim {
  id        String        @id @default(uuid())
  itemId    String
  item      LostFoundItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  studentId String
  student   Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  message   String?
  status    String        @default("PENDING")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([itemId, studentId])
  @@index([itemId])
  @@index([studentId])
}

model SyncHistory {
  id           String    @id @default(uuid())
  requestId    String    @unique
  studentId    String
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  provider     String
  browserId    String?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  status       String    @default("RUNNING")
  durationMs   Int?
  pagesScraped String?   @default("{}")
  error        String?

  @@index([studentId])
  @@index([startedAt])
  @@index([status])
}

model StaffScope {
  id         String   @id @default(uuid())
  adminId    String
  admin      Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  scopeType  String   @default("DEPARTMENT")
  scopeValue String
  createdAt  DateTime @default(now())

  @@unique([adminId, scopeType, scopeValue])
  @@index([adminId])
  @@index([scopeValue])
}

model DepartmentAlias {
  id        String   @id @default(uuid())
  rawValue  String   @unique
  canonical String
  createdAt DateTime @default(now())

  @@index([canonical])
}

model LibraryAudience {
  id         String          @id @default(uuid())
  materialId String
  material   LibraryMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  targetType String
  canonical  String?
  year       String?
  semester   String?
  section    String?
  studentId  String?
  student    Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([materialId])
  @@index([canonical])
  @@index([studentId])
  @@index([targetType])
}

model StudyMaterial {
  id                 String    @id @default(uuid())
  subjectId          String?
  subject            Subject?  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  category           String    @default("LECTURE_NOTE")
  fileUrl            String?
  fileName           String?
  uploadedByAdminId  String?
  uploadedByAdmin    Admin?    @relation(fields: [uploadedByAdminId], references: [id], onDelete: SetNull)
  uploadedByName     String?
  uploadedByRole     String?
  branch             String?   @default("")
  year               String?   @default("")
  semester           String?   @default("")
  section            String?   @default("ALL")
  publishedAt        DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([branch, semester, section])
  @@index([subjectId])
  @@index([uploadedByAdminId])
  @@index([createdAt])
}

model LmsAssignment {
  id                 String          @id @default(uuid())
  subjectId          String?
  subject            Subject?        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectCode        String?
  subjectName        String?
  title              String
  description        String?
  instructions       String?
  dueDate            DateTime
  maxMarks           Int             @default(100)
  attachmentUrl      String?
  attachmentName     String?
  createdByAdminId   String?
  createdByAdmin     Admin?          @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)
  createdByName      String?
  createdByRole      String?
  branch             String?         @default("")
  year               String?         @default("")
  semester           String?         @default("")
  section            String?         @default("ALL")
  status             String          @default("PUBLISHED")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  submissions        LmsSubmission[]

  @@index([branch, semester, section])
  @@index([subjectId])
  @@index([dueDate])
  @@index([status])
  @@index([createdByAdminId])
}

model LmsSubmission {
  id                 String        @id @default(uuid())
  assignmentId       String
  assignment         LmsAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId          String
  student            Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submissionText     String?
  fileUrl            String?
  fileName           String?
  submittedAt        DateTime      @default(now())
  status             String        @default("SUBMITTED")
  marks              Float?
  grade              String?
  feedback           String?
  gradedAt           DateTime?
  gradedByAdminId    String?
  gradedByAdmin      Admin?        @relation(fields: [gradedByAdminId], references: [id], onDelete: SetNull)
  gradedByName       String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@index([status])
  @@index([gradedByAdminId])
}

model Achievement {
  id                 String    @id @default(uuid())
  title              String
  description        String
  imageUrl           String?
  achievementDate    DateTime  @default(now())
  category           String    @default("OTHER")
  branch             String
  participantName    String?
  createdByAdminId   String?
  createdByAdmin     Admin?    @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)
  createdByName      String?
  createdByRole      String?
  isPublished        Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([branch])
  @@index([isPublished])
  @@index([category])
  @@index([createdAt])
}
